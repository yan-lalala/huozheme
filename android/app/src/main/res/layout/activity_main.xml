<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F8FAFC">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌱 活着么 · 安卓守护伴侣"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="轻量后台服务 · 每日首次解锁屏幕静默报平安"
        android:textSize="12sp"
        android:textColor="#64748B"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E2E8F0"
        android:padding="12dp"
        android:text="状态：检测中..."
        android:textColor="#334155"
        android:textSize="13sp"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="云端服务器地址"
        android:textSize="12sp"
        android:textColor="#475569"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/etServerUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="http://192.168.1.100:3000"
        android:textSize="14sp"
        android:padding="10dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="我的专属设备 Token"
        android:textSize="12sp"
        android:textColor="#475569"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/etToken"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="在微信小程序中复制粘贴"
        android:textSize="14sp"
        android:padding="10dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="保存并启用自动监听"
        android:backgroundTint="#059669"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnTest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="立即测试打卡一次"
        android:backgroundTint="#0284C7"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnBattery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="设置自启与电池白名单 (防杀)"
        android:backgroundTint="#475569"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="* 提示：设置保存后即可将本应用放入后台。手机重启后会自动唤醒，每天只有第一次屏幕解锁会静默发送一条数据，后续自动休眠，绝不多耗电。"
        android:textSize="11sp"
        android:textColor="#94A3B8"
        android:lineSpacingExtra="3dp"/>

</LinearLayout>
