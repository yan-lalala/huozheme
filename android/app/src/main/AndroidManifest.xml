<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.huozheme.companion">

    <!-- 基础网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 关键核心：开机自启权限（重启手机后自动继续监听） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 保持屏幕与唤醒权限（短暂发送 0.1 秒打卡请求） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 申请忽略电池优化白名单（防止被国产安卓系统清理后台） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="活着么·守护伴侣"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Huozheme"
        android:usesCleartextTraffic="true">

        <!-- 首次绑定设置主界面 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 核心监听器：手机解锁与充电广播 (USER_PRESENT / POWER_CONNECTED) -->
        <receiver
            android:name=".receiver.UnlockReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <!-- 屏幕解锁成功广播 -->
                <action android:name="android.intent.action.USER_PRESENT" />
                <!-- 插上电源/开始充电广播 -->
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
            </intent-filter>
        </receiver>

        <!-- 关机重启自动恢复监听器 (BOOT_COMPLETED) -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
